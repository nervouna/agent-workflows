#!/bin/sh
set -eu

repo_root=$(git rev-parse --show-toplevel)
gitleaks_bin="$repo_root/.tools/gitleaks/gitleaks"

if [ ! -x "$gitleaks_bin" ]; then
  gitleaks_bin=$(command -v gitleaks || true)
fi

if [ -z "$gitleaks_bin" ]; then
  echo "gitleaks is required for commits in codex-maintenance." >&2
  echo "Install it at .tools/gitleaks/gitleaks or make it available on PATH." >&2
  exit 1
fi

"$gitleaks_bin" protect --staged --redact
